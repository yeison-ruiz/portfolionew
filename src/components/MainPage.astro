---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Hero from "./Hero.astro";
import Timeline from "./Timeline.astro";
import Services from "./Services.astro";
import Projects from "./Projects.astro";
import Contact from "./Contact.astro";
import ChatWidget from "./ChatWidget";
import VisitorAlert from "./VisitorAlert";
import { db } from "../utils/db";
import Authority from "./Authority.astro";
import Footer from "./Footer.astro";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const data = db[lang];

// Dynamically set title and description based on language
const title = lang === "es" 
  ? "Yeison Ruiz | Full Stack Developer · Web Apps, SEO & Performance"
  : "Yeison Ruiz | Full Stack Developer · Web Apps, SEO & Performance";

const description = lang === "es"
  ? "Portfolio profesional de Yeison Ruiz, Full Stack Developer especializado en aplicaciones web, SEO y rendimiento."
  : "Professional portfolio of Yeison Ruiz, Full Stack Developer specialized in web apps, SEO and performance.";

const { slugs } = data.ui;
const sectionSlugs = [slugs.home, slugs.timeline, slugs.certificaciones, slugs.services, slugs.projects, slugs.contact];
---

<Layout title={title} description={description} lang={lang}>
  <Navbar lang={lang} />

  <ChatWidget client:idle lang={lang} />
  <VisitorAlert client:only="react" lang={lang} />

  <main class="relative w-full h-screen overflow-hidden bg-transparent">
    <!-- Fondo Imagen User (Sin degradados) -->
    <div class="absolute inset-0 z-0 pointer-events-none bg-[#020617]">
      <div class="absolute inset-0 bg-[url('/fondoweb.webp')] bg-cover bg-center bg-no-repeat opacity-90"></div>
      <!-- Darkening only. A backdrop-filter here would make the GPU re-sample
           and blur the whole viewport every frame, and at 1px the result was
           indistinguishable from no blur at all. -->
      <div class="absolute inset-0 bg-[#020617]/40"></div>
      
      <!-- Textura de malla para darle el toque premium -->
      <div class="absolute inset-0 opacity-30 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)]" style="background-size: 40px 40px; mask-image: radial-gradient(ellipse at center, black 0%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 80%);"></div>
    </div>
    <!-- Section 0: Hero -->
    <section
      id="section-0"
      class="full-page-section z-0 opacity-0 pointer-events-none"
    >
      <div
        id="hero-scroll-container"
        class="w-full h-full flex flex-col justify-start lg:justify-between overflow-y-auto lg:overflow-hidden no-scrollbar"
      >
        <Hero lang={lang} />
        <Footer lang={lang} isHome={true} />
      </div>
    </section>

    <!-- Section 1: Timeline -->
    <section
      id="section-1"
      class="full-page-section z-0 opacity-0 pointer-events-none"
    >
      <div
        id="timeline-scroll-container"
        class="w-full h-full overflow-y-auto no-scrollbar"
      >
        <Timeline lang={lang} />
        <Footer lang={lang} />
      </div>
    </section>

    <!-- Section 2: Authority -->
    <section
      id="section-2"
      class="full-page-section z-0 opacity-0 pointer-events-none"
    >
      <div
        id="certificaciones-scroll-container"
        class="w-full h-full overflow-y-auto no-scrollbar"
      >
        <Authority lang={lang} />
        <Footer lang={lang} />
      </div>
    </section>

    <!-- Section 3: Services -->
    <section
      id="section-3"
      class="full-page-section z-0 opacity-0 pointer-events-none"
    >
      <div
        id="services-scroll-container"
        class="w-full h-full overflow-y-auto no-scrollbar"
      >
        <Services lang={lang} />
        <Footer lang={lang} />
      </div>
    </section>

    <!-- Section 4: Projects -->
    <section
      id="section-4"
      class="full-page-section z-0 opacity-0 pointer-events-none"
    >
      <div
        id="projects-scroll-container"
        class="w-full h-full overflow-y-auto no-scrollbar"
      >
        <Projects lang={lang} />
        <Footer lang={lang} />
      </div>
    </section>

    <!-- Section 5: Contact -->
    <section
      id="section-5"
      class="full-page-section z-0 opacity-0 pointer-events-none"
    >
      <div
        id="contact-scroll-container"
        class="w-full h-full overflow-y-auto no-scrollbar"
      >
        <Contact lang={lang} />
      </div>
    </section>
  </main>

  <!-- Pass slugs to client-side script -->
  <div id="slugs-data" data-slugs={JSON.stringify(sectionSlugs)} hidden></div>
</Layout>

<style>
  .full-page-section {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;

    /* The opacity-0 utility on the markup hides a section without saving any
       work: a transparent element is still laid out, painted and composited,
       so every backdrop-filter, gradient and mask in all six sections was
       being rendered on load. visibility:hidden lets the browser skip them
       outright. GSAP's autoAlpha sets visibility inline on the active section,
       so this only governs the initial state. */
    visibility: hidden;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { Observer } from "gsap/Observer";

  gsap.registerPlugin(ScrollTrigger, Observer);

  const sectionAliases: string[][] = [
    ["", "home", "inicio"],
    ["timeline", "trayectoria", "experience"],
    ["certificaciones", "certifications", "authority"],
    ["services", "servicios"],
    ["projects", "proyectos"],
    ["contact", "contactenos", "contacto"]
  ];

  function findSectionIndex(slug: string): number {
    if (!slug) return 0;
    const clean = slug.toLowerCase().replace('#', '');
    const index = sectionAliases.findIndex(aliases => aliases.includes(clean));
    return index !== -1 ? index : 0;
  }

  const initAnimations = () => {
    const sections = Array.from(
      document.querySelectorAll(".full-page-section"),
    ) as HTMLElement[];
    const slugsData = document.getElementById("slugs-data");
    const sectionSlugs: string[] = slugsData ? JSON.parse(slugsData.getAttribute("data-slugs") || "[]") : [];

    // Nothing is fetched when a section changes - the markup is already in the
    // DOM - so the transition only has to read as a change, not cover a wait.
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const isMobile = window.innerWidth < 768;
    const TRANSITION_DURATION = prefersReducedMotion || isMobile ? 0.1 : 0.25;

    // Just long enough to keep one gesture from firing twice. The previous
    // 1500ms left the page ignoring input for almost a second after the
    // animation had already finished, which reads as broken rather than slow.
    const TRANSITION_COOLDOWN_MS = 800;

    let currentIndex = 0;
    let isAnimating = false;
    let lastTransitionTime = 0;
    let lastWheelEventTime = 0;
    let edgeReachedTime = 0;
    let wasAtEdge = false;

    // Mirrors currentIndex but is updated the moment a transition starts, while
    // currentIndex only settles in the GSAP onComplete. Media decisions need the
    // incoming section immediately, otherwise a video is paused mid-transition.
    let activeIndex = 0;

    // The direction argument is kept for readability at the call sites and for
    // future direction-aware transitions; the underscore marks it as
    // deliberately unused rather than forgotten.
    function gotoSection(index: number, _direction: number) {
      if (isAnimating) return;
      isAnimating = true;
      wasAtEdge = false;
      edgeReachedTime = Date.now();
      lastTransitionTime = Date.now();

      const currentSection = sections[currentIndex];
      const nextSection = sections[index];

      if (!currentSection || !nextSection) {
        isAnimating = false;
        return;
      }

      const nextScrollContainer = nextSection.querySelector(
        ".overflow-y-auto",
      ) as HTMLElement;
      if (nextScrollContainer) {
        nextScrollContainer.scrollTop = 0;
      }

      activeIndex = index;

      gsap.set(nextSection, { zIndex: 10, autoAlpha: 1 });
      gsap.set(currentSection, { zIndex: 0 });

      window.dispatchEvent(
        new CustomEvent("sectionChange", { detail: { index } }),
      );

      const slug = sectionSlugs[index];
      const cleanPath = window.location.pathname.replace(/\/+$/, "");
      const baseDir = cleanPath ? cleanPath : "";
      const newUrl = slug ? `${baseDir}/#${slug}` : (baseDir || "/");
      window.history.replaceState(null, "", newUrl);

      const tl = gsap.timeline({
        onComplete: () => {
          isAnimating = false;
          currentIndex = index;
          gsap.set(currentSection, { autoAlpha: 0, pointerEvents: "none" });
          gsap.set(nextSection, { pointerEvents: "auto" });

          // Ten ScrollTrigger instances live across five sections, and a full
          // refresh re-measures all of them. Sections are absolutely positioned
          // and identically sized, so a transition never changes their
          // geometry; the refresh only matters because deferred images can
          // change a scroll container's height. Running it while the browser is
          // idle keeps that forced layout out of the frame the user is waiting
          // to interact with.
          const runRefresh = () => ScrollTrigger.refresh();
          if ("requestIdleCallback" in window) {
            requestIdleCallback(runRefresh, { timeout: 1000 });
          } else {
            setTimeout(runRefresh, 200);
          }
        },
      });

      // Opacity alone composites on the GPU. Animating scale forces the whole
      // section subtree - backdrop-filters included - to re-rasterize each
      // frame, which was the expensive half of this transition.
      tl.to(
        currentSection,
        {
          opacity: 0,
          duration: TRANSITION_DURATION,
          ease: "power2.inOut",
        },
        0,
      );

      tl.fromTo(
        nextSection,
        { opacity: 0 },
        {
          opacity: 1,
          duration: TRANSITION_DURATION,
          ease: "power2.inOut",
        },
        0,
      );
    }

    Observer.create({
      target: window,
      type: "wheel,touch,pointer",
      wheelSpeed: -1,
      onUp: (self: any) => handleScroll(-1, self.event),
      onDown: (self: any) => handleScroll(1, self.event),
      tolerance: 20, 
      preventDefault: false,
    });

    function handleScroll(direction: number, event?: Event) {
      if (isAnimating) return;

      // Do not automatically switch section on wheel/touch when on Home section (index 0)
      if (currentIndex === 0) return;

      if (Date.now() - lastTransitionTime < TRANSITION_COOLDOWN_MS) return;

      if (event && event.target) {
        const target = event.target as HTMLElement;
        if (target.closest("#scene-container")) {
          if (event.type !== "wheel") return;
        }
      }

      const currentSection = sections[currentIndex];
      if (!currentSection) return;

      const scrollContainer = currentSection.querySelector(
        ".overflow-y-auto",
      ) as HTMLElement;

      const now = Date.now();
      const timeSinceLastWheel = now - lastWheelEventTime;
      lastWheelEventTime = now;

      if (scrollContainer) {
        const { scrollTop, scrollHeight, clientHeight } = scrollContainer;
        const tolerance = 5;
        const isAtTop = scrollTop <= tolerance;
        const isAtBottom = Math.ceil(scrollTop + clientHeight) >= scrollHeight - tolerance;

        const isAtEdgeInput = (direction > 0 && isAtBottom) || (direction < 0 && isAtTop);

        if (!isAtEdgeInput) {
          wasAtEdge = false;
          return;
        }

        if (!wasAtEdge) {
          wasAtEdge = true;
          edgeReachedTime = now;
          return;
        }

        if (timeSinceLastWheel < 100) {
          if (now - edgeReachedTime < 1000) return;
        }

        if (direction > 0) {
          if (currentIndex < sections.length - 1) {
            gotoSection(currentIndex + 1, 1);
            wasAtEdge = false;
          }
        } else {
          if (currentIndex > 0) {
            gotoSection(currentIndex - 1, -1);
            wasAtEdge = false;
          }
        }
      } else {
        if (direction > 0 && currentIndex < sections.length - 1) {
          gotoSection(currentIndex + 1, 1);
          wasAtEdge = false;
        } else if (direction < 0 && currentIndex > 0) {
          gotoSection(currentIndex - 1, -1);
          wasAtEdge = false;
        }
      }
    }

    // Handle all anchor clicks dynamically (internal section links only)
    const handleAnchorClick = (e: MouseEvent) => {
      const anchor = (e.target as HTMLElement).closest('a');
      if (!anchor) return;
      
      const href = anchor.getAttribute("href") || "";
      
      if (href.startsWith("#")) {
        const rawSlug = href.substring(1);
        const targetIndex = findSectionIndex(rawSlug);

        e.preventDefault();
        if (targetIndex !== currentIndex) {
          gotoSection(targetIndex, targetIndex > currentIndex ? 1 : -1);
        }
      }
    };

    document.addEventListener("click", handleAnchorClick);

    // Optimized Video Management for Mobile
    //
    // Sections are absolutely positioned and stacked, so every one of them
    // intersects the viewport regardless of which is currently shown. Playing on
    // intersection alone would therefore start every video at load and download
    // them all. Only videos inside the active section are allowed to play; the
    // sectionChange listener below wakes the rest as the user navigates.
    const videos = document.querySelectorAll('video');
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target as HTMLVideoElement;
        const section = video.closest('.full-page-section');
        const isInActiveSection = !section || section === sections[activeIndex];

        if (entry.isIntersecting && isInActiveSection) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    }, { threshold: [0.01, 0.1] });

    videos.forEach(v => videoObserver.observe(v));

    // Listen for section changes to specifically wake up videos in the active section
    window.addEventListener("sectionChange", (e: any) => {
      const activeSection = sections[e.detail.index];
      if (activeSection) {
        const sectionVideos = activeSection.querySelectorAll('video');
        sectionVideos.forEach((v: any) => {
          v.play().catch(() => {});
        });
      }
    });

    // Handle initial hash on load - SILENT JUMP (no animation) to avoid the "flash"
    const hash = window.location.hash.substring(1);
    const finalIndex = findSectionIndex(hash);
    
    // Jump to the correct section immediately
    const targetSection = sections[finalIndex];
    if (targetSection) {
        // Immediate state change without GSAP timeline/delay
        gsap.set(targetSection, { autoAlpha: 1, zIndex: 10, pointerEvents: "auto", scale: 1 });
        currentIndex = finalIndex;
        activeIndex = finalIndex;
        
        // Sync the Navbar immediately if it's not the first section
        // (If it's the first section, Navbar is already at Home)
        window.dispatchEvent(
            new CustomEvent("sectionChange", { detail: { index: finalIndex } })
        );
        
        // Wake up videos in the target section
        const sectionVideos = targetSection.querySelectorAll('video');
        sectionVideos.forEach((v: any) => v.play().catch(() => {}));
    }
  };

  document.addEventListener("astro:page-load", initAnimations);
  // Also run on initial load if not using view transitions or if they are already handled
  if (document.readyState === 'complete') {
    initAnimations();
  } else {
    window.addEventListener('load', initAnimations);
  }
</script>
