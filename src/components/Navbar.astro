---
import { db } from "../utils/db";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const { personalInfo, ui } = db[lang];
const initials = `${personalInfo.name[0]}${personalInfo.lastName[0]}`;

const otherLang = lang === "es" ? "en" : "es";
const langLabel = lang === "es" ? "EN" : "ES";

// English is served from the root and Spanish from /es; there is no /en route.
// Both of these used to assume the opposite, which is what sent the logo to the
// 404 page from the English home.
const homePath = lang === "es" ? "/es" : "/";
const langPath = lang === "es" ? "/" : "/es";
---

<header
  class="fixed top-0 md:top-6 left-0 md:left-1/2 md:-translate-x-1/2 w-full md:w-[95%] lg:w-[82%] max-w-5xl z-50 flex items-center justify-between px-6 md:px-8 py-3.5 md:py-2.5 bg-bg-dark/60 backdrop-blur-xl border-b md:border border-white/10 md:rounded-full shadow-lg md:shadow-[0_8px_32px_rgba(0,0,0,0.4)] transition-all duration-500"
>
  <!-- Logo -->
  <a
    href={lang === 'es' ? '/es/#inicio' : '/#home'}
    data-astro-reload
    class="text-3xl md:text-3xl font-black text-white flex items-center gap-1.5 group tracking-tighter logo-link"
    data-slug={ui.slugs.home}
  >
    <span class="text-primary group-hover:text-white transition-colors duration-400 bracket-left">&lt;</span>
    <span class="initials group-hover:text-primary transition-colors duration-400">{initials}</span>
    <span class="text-primary group-hover:text-white transition-colors duration-400 bracket-right">/&gt;</span>
  </a>

  <!-- Navigation Links -->
  <nav class="hidden md:block">
    <ul class="flex items-center gap-1 lg:gap-2 list-none m-0 p-0">
      <li>
        <a
          href={`#${ui.slugs.timeline}`}
          data-astro-reload
          class="nav-link relative z-10 px-4 py-2 text-text-secondary hover:text-white transition-all duration-300 font-semibold text-[15px] inline-flex items-center justify-center rounded-full"
          data-slug={ui.slugs.timeline}
        >
          {ui.nav.timeline}
        </a>
      </li>
      <li>
        <a
          href={`#${ui.slugs.certificaciones}`}
          data-astro-reload
          class="nav-link relative z-10 px-4 py-2 text-text-secondary hover:text-white transition-all duration-300 font-semibold text-[15px] inline-flex items-center justify-center rounded-full"
          data-slug={ui.slugs.certificaciones}
        >
          {ui.nav.certificaciones}
        </a>
      </li>
      <li>
        <a
          href={`#${ui.slugs.services}`}
          data-astro-reload
          class="nav-link relative z-10 px-4 py-2 text-text-secondary hover:text-white transition-all duration-300 font-semibold text-[15px] inline-flex items-center justify-center rounded-full"
          data-slug={ui.slugs.services}
        >
          {ui.nav.services}
        </a>
      </li>
      <li>
        <a
          href={`#${ui.slugs.projects}`}
          data-astro-reload
          class="nav-link relative z-10 px-4 py-2 text-text-secondary hover:text-white transition-all duration-300 font-semibold text-[15px] inline-flex items-center justify-center rounded-full"
          data-slug={ui.slugs.projects}
        >
          {ui.nav.projects}
        </a>
      </li>
    </ul>
  </nav>

  <!-- Actions -->
  <div class="flex items-center gap-3">
    <!-- Language Switcher -->
    <div class="flex items-center gap-1 p-1 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm">
      <a
        id="lang-btn-es"
        href="/es"
        class={`flex items-center gap-1.5 px-2.5 py-1 rounded-full transition-all ${lang === 'es' ? 'bg-primary text-[#020617] shadow-sm font-extrabold' : 'text-text-secondary hover:text-white hover:bg-white/5 font-bold'}`}
        aria-label="Español"
      >
        <img src="https://flagcdn.com/w80/es.png" alt="ES flag" class="w-4 h-4 rounded-full object-cover shadow-[0_1px_3px_rgba(0,0,0,0.3)]" />
        <span class="text-[12px] font-bold">ES</span>
      </a>
      <a
        id="lang-btn-en"
        href="/"
        class={`flex items-center gap-1.5 px-2.5 py-1 rounded-full transition-all ${lang === 'en' ? 'bg-primary text-[#020617] shadow-sm font-extrabold' : 'text-text-secondary hover:text-white hover:bg-white/5 font-bold'}`}
        aria-label="English"
      >
        <img src="https://flagcdn.com/w80/us.png" alt="EN flag" class="w-4 h-4 rounded-full object-cover shadow-[0_1px_3px_rgba(0,0,0,0.3)]" />
        <span class="text-[12px] font-bold">EN</span>
      </a>
    </div>

    <!-- CTA Button -->
    <a
      href={`#${ui.slugs.contact}`}
      data-astro-reload
      class="hidden md:inline-flex items-center justify-center px-5 py-2 border border-white/20 rounded-full text-sm font-bold text-white bg-white/5 hover:bg-white/10 hover:border-white/40 hover:scale-105 active:scale-95 transition-all duration-300"
    >
      {lang === 'es' ? 'Hablemos' : "Let's Talk"}
    </a>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-button"
      class="md:hidden flex flex-col justify-center items-center gap-1.5 w-10 h-10 rounded-full bg-white/5 border border-white/10 text-white z-100"
      aria-label="Toggle menu"
    >
      <span class="w-5 h-0.5 bg-white transition-all duration-300 origin-center"></span>
      <span class="w-5 h-0.5 bg-white transition-all duration-300 origin-center"></span>
      <span class="w-5 h-0.5 bg-white transition-all duration-300 origin-center"></span>
    </button>
  </div>
</header>

<!-- Mobile Content: Navigation Overlay

     No backdrop-filter here: the background is already 95% opaque, so a blur
     behind it is invisible, and a full-screen backdrop-filter is the most
     expensive thing a mobile GPU can be asked to composite - re-sampled every
     frame while the panel slides in. -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-40 bg-bg-dark/95 flex flex-col justify-center items-center p-8 translate-x-full transition-transform duration-300 ease-out md:hidden"
>
  <nav class="w-full">
    <ul class="flex flex-col items-center gap-6 list-none m-0 p-0 w-full">
      <li class="w-full text-center">
        <a
          href={`#${ui.slugs.timeline}`}
          data-astro-reload
          class="mobile-nav-link text-2xl font-bold text-gray-400 hover:text-white transition-colors py-2 block w-full"
        >
          {ui.nav.timeline}
        </a>
      </li>
      <li class="w-full text-center">
        <a
          href={`#${ui.slugs.certificaciones}`}
          data-astro-reload
          class="mobile-nav-link text-2xl font-bold text-gray-400 hover:text-white transition-colors py-2 block w-full"
        >
          {ui.nav.certificaciones}
        </a>
      </li>
      <li class="w-full text-center">
        <a
          href={`#${ui.slugs.services}`}
          data-astro-reload
          class="mobile-nav-link text-2xl font-bold text-gray-400 hover:text-white transition-colors py-2 block w-full"
        >
          {ui.nav.services}
        </a>
      </li>
      <li class="w-full text-center">
        <a
          href={`#${ui.slugs.projects}`}
          data-astro-reload
          class="mobile-nav-link text-2xl font-bold text-gray-400 hover:text-white transition-colors py-2 block w-full"
        >
          {ui.nav.projects}
        </a>
      </li>
      <li class="w-full text-center mt-4">
        <a
          href={`#${ui.slugs.contact}`}
          data-astro-reload
          class="mobile-nav-link inline-flex items-center justify-center px-10 py-4 bg-primary text-[#020617] rounded-2xl text-lg font-bold hover:scale-105 active:scale-95 transition-all shadow-[0_8px_32px_rgba(234,179,8,0.3)]"
        >
          {lang === 'es' ? 'Hablemos' : "Let's Talk"}
        </a>
      </li>
    </ul>
  </nav>
</div>

<!-- Data for dynamic language switching -->
<div 
  id="lang-data" 
  data-es-slugs={JSON.stringify([
    db['es'].ui.slugs.home,
    db['es'].ui.slugs.timeline,
    db['es'].ui.slugs.certificaciones,
    db['es'].ui.slugs.services,
    db['es'].ui.slugs.projects,
    db['es'].ui.slugs.contact
  ])} 
  data-en-slugs={JSON.stringify([
    db['en'].ui.slugs.home,
    db['en'].ui.slugs.timeline,
    db['en'].ui.slugs.certificaciones,
    db['en'].ui.slugs.services,
    db['en'].ui.slugs.projects,
    db['en'].ui.slugs.contact
  ])} 
  hidden
></div>

<style>
/* Extreme Logo Active State */
  .logo-link {
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    padding: 6px 16px;
    border-radius: 9999px;
    border: 1px solid transparent;
  }

  /* Subtle Minimalist Active state for nav links */
  .nav-link.active {
    color: var(--color-primary) !important;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    font-weight: 800;
    transform: translateY(-1px);
  }

  /* Mobile Active State */
  .mobile-nav-link.active {
    color: var(--color-primary) !important;
    background: rgba(255, 255, 255, 0.05);
    font-weight: 900;
    padding: 10px 28px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  
  /* Hover effect for inactive links */
  .nav-link:not(.active):hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  /* Hamburger Animation */
  #mobile-menu-button.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #mobile-menu-button.active span:nth-child(2) {
    opacity: 0;
    transform: translateX(-10px);
  }
  #mobile-menu-button.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");

  const resetLinks = () => {
    navLinks.forEach((link) => {
      link.classList.remove("active", "text-white");
    });
    mobileLinks.forEach((link) => {
      link.classList.remove("active", "text-white");
    });
    document.querySelector(".logo-link")?.classList.remove("active");
  };

  const activateLink = (index: number) => {
    resetLinks();
    
    // Get all section slugs from MainPage
    const slugsData = document.getElementById("slugs-data");
    const sectionSlugs: string[] = slugsData ? JSON.parse(slugsData.getAttribute("data-slugs") || "[]") : [];
    const currentSlug = sectionSlugs[index];

    // Update language toggle URLs
    const langData = document.getElementById("lang-data");
    const esToggle = document.getElementById("lang-btn-es") as HTMLAnchorElement;
    const enToggle = document.getElementById("lang-btn-en") as HTMLAnchorElement;
    if (langData) {
      const esSlugs = JSON.parse(langData.getAttribute("data-es-slugs") || "[]");
      const enSlugs = JSON.parse(langData.getAttribute("data-en-slugs") || "[]");
      const esSlug = esSlugs[index];
      const enSlug = enSlugs[index];
      if (esToggle) esToggle.href = esSlug && index > 0 ? `/es/#${esSlug}` : "/es/";
      if (enToggle) enToggle.href = enSlug && index > 0 ? `/#${enSlug}` : "/";
    }

    if (currentSlug !== undefined) {
      // Desktop links
      navLinks.forEach(link => {
        if (link.getAttribute("data-slug") === currentSlug) {
          link.classList.add("active");
        }
      });

      // Mobile links
      mobileLinks.forEach(link => {
        const href = link.getAttribute("href")?.split('#')[1];
        if (href === currentSlug) {
          link.classList.add("active");
        }
      });
    }
  };

  // Listen for section changes from MainPage.astro
  window.addEventListener("sectionChange", ((e: CustomEvent) => {
    activateLink(e.detail.index);
  }) as EventListener);

  // Mobile Menu Logic
  const menuButton = document.getElementById("mobile-menu-button");
  const menuOverlay = document.getElementById("mobile-menu-overlay");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  const toggleMenu = () => {
    const isOpen = menuButton?.classList.contains("active");
    if (isOpen) {
      menuButton?.classList.remove("active");
      menuOverlay?.classList.add("translate-x-full");
      document.body.style.overflow = "";
    } else {
      menuButton?.classList.add("active");
      menuOverlay?.classList.remove("translate-x-full");
      document.body.style.overflow = "hidden";
    }
  };

  menuButton?.addEventListener("click", toggleMenu);

  mobileLinks.forEach(link => {
    link.addEventListener("click", () => {
      menuButton?.classList.remove("active");
      menuOverlay?.classList.add("translate-x-full");
      document.body.style.overflow = "";
    });
  });

  // Initial check focused on current hash
  const sectionAliasesNav: string[][] = [
    ["", "home", "inicio"],
    ["timeline", "trayectoria", "experience"],
    ["certificaciones", "certifications", "authority"],
    ["services", "servicios"],
    ["projects", "proyectos"],
    ["contact", "contactenos", "contacto"]
  ];
  const initialHash = window.location.hash.substring(1).toLowerCase();
  const initialIndex = initialHash ? sectionAliasesNav.findIndex(aliases => aliases.includes(initialHash)) : 0;
  
  activateLink(initialIndex !== -1 ? initialIndex : 0);
</script>
