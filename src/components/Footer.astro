---
import { db } from "../utils/db";

interface Props {
  lang?: "es" | "en";
  isHome?: boolean;
}

const { lang = "es", isHome = false } = Astro.props;
const { personalInfo, ui } = db[lang];
const { slugs } = ui;

const tickerMessages = lang === "es" ? [
  "Construyendo aplicaciones web de alto rendimiento e integraciones de IA",
  "Especializado en React, Next.js, Astro y arquitectura full-stack moderna",
  "Transformando ideas complejas en experiencias digitales de alto impacto",
  "Core Web Vitals 100% optimizados • Código limpio y diseño escalable"
] : [
  "Building high-performance web applications & AI integrations",
  "Specializing in React, Next.js, Astro & modern full-stack architecture",
  "Turning complex business ideas into seamless digital experiences",
  "100% Optimized Core Web Vitals • Clean Code & Scalable Architecture"
];
---

<footer class="mt-auto border-t border-white/5 bg-[#0A0A0A]/50 backdrop-blur-md shrink-0">
  <div class="container mx-auto px-6 py-4 md:py-3">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 md:gap-8">
      <!-- Brand Logo (Left on Desktop) -->
      <div class="flex-1 flex justify-center md:justify-start">
        <a
          href={lang === 'es' ? "/" : `/${lang}`}
          class="text-2xl font-black text-white flex items-center gap-1 group tracking-tighter"
        >
          <span class="text-primary group-hover:text-white transition-colors duration-400">&lt;</span>
          <span class="group-hover:text-primary transition-colors duration-400">{personalInfo.name[0]}{personalInfo.lastName[0]}</span>
          <span class="text-primary group-hover:text-white transition-colors duration-400">/&gt;</span>
        </a>
      </div>

      <!-- Center Content: Animated Ticker on Home, Navigation Menu on other sections -->
      {isHome ? (
        <div class="flex-2 flex flex-col items-center justify-center min-w-0">
          <div class="relative h-7 w-full max-w-lg md:max-w-2xl overflow-hidden flex items-center justify-center">
            {tickerMessages.map((msg, i) => (
              <p
                class={`footer-ticker-item text-xs sm:text-sm md:text-[15px] font-bold tracking-tight text-gray-200 transition-all duration-700 ease-out absolute w-full text-center truncate ${i === 0 ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 translate-y-4 scale-95 pointer-events-none'}`}
                data-index={i}
              >
                {msg}
              </p>
            ))}
          </div>
          <p class="text-xs text-gray-400 font-medium tracking-wide mt-1">
            © {new Date().getFullYear()} {personalInfo.name} {personalInfo.lastName}. {ui.footer.rights}
          </p>
        </div>
      ) : (
        <div class="flex-2 flex flex-col items-center gap-4 md:gap-3">
          <nav class="flex flex-wrap justify-center items-center gap-x-6 gap-y-4 md:gap-x-8 md:gap-y-3">
            <a
              href={`#${slugs.timeline}`}
              class="footer-nav-link text-sm text-gray-400 hover:text-white transition-all duration-300 font-medium whitespace-nowrap px-3 py-1 rounded-full"
              data-slug={slugs.timeline}
              >{ui.nav.timeline}</a
            >
            <a
              href={`#${slugs.certificaciones}`}
              class="footer-nav-link text-sm text-gray-400 hover:text-white transition-all duration-300 font-medium whitespace-nowrap px-3 py-1 rounded-full"
              data-slug={slugs.certificaciones}
              >{ui.nav.certificaciones}</a
            >
            <a
              href={`#${slugs.services}`}
              class="footer-nav-link text-sm text-gray-400 hover:text-white transition-all duration-300 font-medium whitespace-nowrap px-3 py-1 rounded-full"
              data-slug={slugs.services}
              >{ui.nav.services}</a
            >
            <a
              href={`#${slugs.projects}`}
              class="footer-nav-link text-sm text-gray-400 hover:text-white transition-all duration-300 font-medium whitespace-nowrap px-3 py-1 rounded-full"
              data-slug={slugs.projects}
              >{ui.nav.projects}</a
            >
            <a
              href={`#${slugs.contact}`}
              class="footer-nav-link text-sm text-gray-400 hover:text-white transition-all duration-300 font-medium whitespace-nowrap px-3 py-1 rounded-full"
              data-slug={slugs.contact}
              >{ui.nav.contact}</a
            >
          </nav>
          
          <p class="text-xs text-gray-400 font-medium tracking-wide">
            © {new Date().getFullYear()} {personalInfo.name} {personalInfo.lastName}. {ui.footer.rights}
          </p>
        </div>
      )}

      <!-- Social Icons (Right on Desktop) -->
      <div class="flex-1 flex justify-center md:justify-end gap-5">
        {personalInfo.social.github && (
          <a
            href={personalInfo.social.github}
            target="_blank"
            class="text-gray-500 hover:text-white transition-all hover:scale-110"
            aria-label="GitHub"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5-.73 1.02-1.08 2.25-1 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
        )}
        {personalInfo.social.linkedin && (
          <a
            href={personalInfo.social.linkedin}
            target="_blank"
            class="text-gray-500 hover:text-white transition-all hover:scale-110"
            aria-label="LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-nav-link.active {
    color: var(--color-primary) !important;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
</style>

<script>
  const footerLinks = document.querySelectorAll<HTMLAnchorElement>(".footer-nav-link");

  window.addEventListener("sectionChange", ((e: CustomEvent) => {
    const activeIndex = e.detail.index;
    const slugsData = document.getElementById("slugs-data");
    const sectionSlugs: string[] = slugsData ? JSON.parse(slugsData.getAttribute("data-slugs") || "[]") : [];
    const currentSlug = sectionSlugs[activeIndex];

    footerLinks.forEach(link => {
      link.classList.remove("active");
      if (currentSlug && link.getAttribute("data-slug") === currentSlug) {
        link.classList.add("active");
      }
    });
  }) as EventListener);

  const startTicker = () => {
    const tickerItems = document.querySelectorAll<HTMLElement>(".footer-ticker-item");
    if (tickerItems.length > 1) {
      let currentTicker = 0;
      setInterval(() => {
        const prev = tickerItems[currentTicker];
        currentTicker = (currentTicker + 1) % tickerItems.length;
        const next = tickerItems[currentTicker];

        if (prev && next) {
          prev.classList.remove("opacity-100", "translate-y-0", "scale-100");
          prev.classList.add("opacity-0", "-translate-y-4", "scale-95", "pointer-events-none");

          next.classList.remove("opacity-0", "translate-y-4", "-translate-y-4", "scale-95", "pointer-events-none");
          next.classList.add("opacity-100", "translate-y-0", "scale-100");
        }
      }, 3500);
    }
  };

  startTicker();
</script>
